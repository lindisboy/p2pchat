{
  "expo": {
    "name": "p2pchat",
    "slug": "p2pchat",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/branding/p2pchat/app-icon.png",
    "scheme": "p2pchat",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./locales/en.json",
      "hi": "./locales/hi.json",
      "bn": "./locales/bn.json",
      "mr": "./locales/mr.json",
      "te": "./locales/te.json",
      "ta": "./locales/ta.json"
    },
    "ios": {
      "icon": "./assets/branding/p2pchat/app-icon.png",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "p2pchat uses Bluetooth to find nearby phones and pass messages without the internet. This can use more battery, and nearby radio scanners can detect Bluetooth activity. The app does not use GPS.",
        "NSBluetoothPeripheralUsageDescription": "p2pchat advertises over Bluetooth Low Energy so nearby phones can find this one and relay messages without the internet. The advertised identifier is random and changes every 15 minutes.",
        "NSLocalNetworkUsageDescription": "p2pchat uses the local network to exchange messages directly with nearby devices.",
        "NSBonjourServices": [
          "_nearby._tcp",
          "_nearby._udp"
        ]
      },
      "bundleIdentifier": "com.anonymous.p2pchat"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F0E8",
        "foregroundImage": "./assets/branding/p2pchat/native/android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.p2pchat",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false,
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/p2pchat/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F0E8",
          "image": "./assets/branding/p2pchat/logo-paper.png",
          "imageWidth": 240,
          "dark": {
            "backgroundColor": "#17252C",
            "image": "./assets/branding/p2pchat/logo-reverse.png"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "./plugins/withDevelopmentTeam",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "hi",
              "bn",
              "mr",
              "te",
              "ta"
            ],
            "android": [
              "en",
              "hi",
              "bn",
              "mr",
              "te",
              "ta"
            ]
          }
        }
      ],
      "./plugins/withSystemBarContrast",
      "./plugins/withBuildPathPrivacy"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
